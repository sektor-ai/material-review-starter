#!/usr/bin/env bash
#
# Reaps wt environments whose pull request has merged or closed, after a merge or pull.
#
# Installed into the repository's hooks directory (core.hooksPath if set, else .git/hooks) by
# `wt install-hooks`. Worktrees share the primary checkout's hooks directory, so this single hook
# serves every environment. Any hook that was already installed is moved aside to post-merge.pre-wt
# at install time and chain-called here first, so installing `wt` never disables it.
#
# `wt gc` is backgrounded and its errors swallowed: a merge or pull must never fail, nor block on
# gh network calls, because of this hook.

set -uo pipefail

hooks_dir=$(git rev-parse --git-path hooks 2>/dev/null) || exit 0
chained="$hooks_dir/post-merge.pre-wt"

chained_status=0
if [[ -x $chained ]]; then
	"$chained" "$@" || chained_status=$?
fi

top=$(git rev-parse --show-toplevel 2>/dev/null) || exit "$chained_status"
wt="$top/tools/wt/wt.sh"
[[ -x $wt ]] || exit "$chained_status"

nohup "$wt" gc >/dev/null 2>&1 &

exit "$chained_status"
